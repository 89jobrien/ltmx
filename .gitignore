/target
**/*.rs.bk
*.pdb
.DS_Store

# libFuzzer's generated corpus is reproducible from the committed seeds in
# fuzz/seeds, so it is not versioned. The seeds themselves are permanent and
# must never be deleted: they encode the input shapes the parser is expected
# to survive.
fuzz/target
fuzz/corpus
fuzz/artifacts

# handoff-begin
.ctx/*
!.ctx/HANDOFF.*.yaml
.ctx/HANDOFF.godmode.*.yaml
.ctx/HANDOFF.*.state.json
!.ctx/handoff.*.config.toml.example
.ctx/HANDOFF.*.*.state.json
.ctx/HANDOFF.hj.hj.state.json
.ctx/.initialized
# handoff-end

.taskit/
memory.mcpmem
memory.mcpmem-shm
memory.mcpmem-wal
memory.mcpmem.workspaces.sqlite
